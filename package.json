{
  "name": "codlogs",
  "version": "1.4.0",
  "private": true,
  "description": "Codex session CLI and Electrobun browser.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "bin": {
    "codlogs": "./codlogs.cjs",
    "codlogs-sessions": "./codlogs-sessions.cjs"
  },
  "scripts": {
    "prepare:desktop": "electrobun prepare",
    "typecheck": "bun run prepare:desktop && tsc --noEmit",
    "test": "bun test src/shared/codlogs-core.test.ts",
    "build:web": "bun run prepare:desktop && vite build",
    "start": "bun run build:web && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "bun run prepare:desktop && vite --port 5173",
    "build": "bun run build:web && electrobun build"
  },
  "files": [
    "README.md",
    "codlogs.cjs",
    "codlogs-sessions.cjs",
    "codlogs-sessions.ts",
    "electrobun.config.ts",
    "hutch.config.ts",
    "bunfig.toml",
    "vite.config.ts",
    "tsconfig.json",
    "src"
  ],
  "engines": {
    "node": ">=22.11.0",
    "bun": ">=1.3.12"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "electrobun": "2.0.1",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "typescript": "^7.0.2",
    "vite": "8.3.1"
  }
}
